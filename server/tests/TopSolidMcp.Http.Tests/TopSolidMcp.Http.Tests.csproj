<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>TopSolidMcpServer.Tests</RootNamespace>
    <AssemblyName>TopSolidMcpServer.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source-linked (no ProjectReference to the exe: Smart App Control on dev
         machines blocks freshly built binaries by hash, FileLoadException 0x800711C7).
         Same pattern as the UpdateCheckLogic tests. -->
    <Compile Include="..\..\src\Protocol\McpHttpAuthLogic.cs" Link="McpHttpAuthLogic.cs" />
    <Compile Include="..\..\src\Protocol\McpOriginPolicy.cs" Link="McpOriginPolicy.cs" />
    <Compile Include="..\..\src\Utils\ApiKeyStore.cs" Link="ApiKeyStore.cs" />
    <Compile Include="..\..\src\Utils\GitHubFeedbackLogic.cs" Link="GitHubFeedbackLogic.cs" />
    <Compile Include="..\..\src\Utils\ReconnectBackoff.cs" Link="ReconnectBackoff.cs" />
    <Compile Include="..\..\src\Utils\ServerLog.cs" Link="ServerLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>TopSolidMcpServer.Tests</RootNamespace>
    <AssemblyName>TopSolidMcpServer.Tests</AssemblyName>
    <Nullable>disable</Nullable>

    <!-- Fail on first failing test, report verbosely -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

    <ItemGroup>
      <Reference Include="System.Management" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="NUnit" Version="3.14.0" />
      <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

  <ItemGroup>
    <!-- Source-linked instead of a ProjectReference to the server exe: Smart App
         Control on dev machines blocks freshly built TopSolidMcpServer.exe by
         hash (FileLoadException 0x800711C7). These tests exercise the pure
         update-check logic, which needs no TopSolid assemblies. -->
    <Compile Include="..\..\update-check\UpdateCheckLogic.cs" Link="UpdateCheckLogic.cs" />
    <Compile Include="..\..\src\Protocol\HttpKeepalivePolicy.cs" Link="HttpKeepalivePolicy.cs" />
    <Compile Include="..\..\src\Utils\TopSolidInstanceList.cs" Link="TopSolidInstanceList.cs" />
    <Compile Include="..\..\src\Utils\DialogReport.cs" Link="DialogReport.cs" />
    <Compile Include="..\..\src\Utils\WindowInfo.cs" Link="WindowInfo.cs" />
    <Compile Include="..\..\src\Utils\ScriptOutputLimit.cs" Link="ScriptOutputLimit.cs" />
    <Compile Include="..\..\src\Utils\TransactionRules.cs" Link="TransactionRules.cs" />
    <Compile Include="..\..\src\Utils\DestructiveGuard.cs" Link="DestructiveGuard.cs" />
    <Compile Include="..\..\src\Utils\KernelVersion.cs" Link="KernelVersion.cs" />
    <Compile Include="..\..\src\Utils\AutoStartLogic.cs" Link="AutoStartLogic.cs" />
    <Compile Include="..\..\src\Utils\TraySettings.cs" Link="TraySettings.cs" />
    <Compile Include="..\..\src\Utils\L10n.cs" Link="L10n.cs" />
    <Compile Include="..\..\src\Protocol\McpToolRegistry.cs" Link="McpToolRegistry.cs" />
    <Compile Include="..\..\src\Protocol\McpToolAnnotations.cs" Link="McpToolAnnotations.cs" />
    <Compile Include="..\..\src\Protocol\Models\McpToolDescriptor.cs" Link="McpToolDescriptor.cs" />
    <Compile Include="..\..\src\Tools\ApiHelpTool.cs" Link="ApiHelpTool.cs" />
    <Compile Include="..\..\src\Utils\DocumentSnapshot.cs" Link="DocumentSnapshot.cs" />
    <Compile Include="..\..\src\Utils\DocumentComparison.cs" Link="DocumentComparison.cs" />
    <Compile Include="..\..\src\Utils\DocumentScripts.cs" Link="DocumentScripts.cs" />
    <Compile Include="..\..\src\Utils\DocumentCompareRunner.cs" Link="DocumentCompareRunner.cs" />
    <Compile Include="..\..\src\Utils\FamilyCatalogScripts.cs" Link="FamilyCatalogScripts.cs" />
    <None Include="Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\TypeGraph.cs" Link="Graph\TypeGraph.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Models\ExtractedMethod.cs" Link="Graph\ExtractedMethod.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Models\GraphEdge.cs" Link="Graph\GraphEdge.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Models\TypeNode.cs" Link="Graph\TypeNode.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Semantics\SemanticRule.cs" Link="Graph\SemanticRule.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Semantics\SemanticRuleSet.cs" Link="Graph\SemanticRuleSet.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Utils\GraphLoader.cs" Link="Graph\GraphLoader.cs" />
    <Compile Include="..\..\..\graph\src\TopSolidApiGraph.Core\Utils\JsonHelper.cs" Link="Graph\JsonHelper.cs" />
  </ItemGroup>

</Project>